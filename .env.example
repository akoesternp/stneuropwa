# Vorlage für die Umgebungsvariablen.
#
# Die Anwendung liest KEINE .env-Datei selbst ein — sie nimmt, was in der
# Umgebung steht. Im Betrieb kommt diese Datei nach /etc/stneuro.env und wird
# von systemd über EnvironmentFile= geladen (deploy/README.md).
# Lokal einfach vor den Befehl schreiben: PORT=3002 npm start

# Port und Schnittstelle. Hinter einem Reverse Proxy MUSS HOST auf 127.0.0.1
# stehen, sonst ist die Anwendung unter Umgehung von Apache direkt erreichbar
# — und damit ohne HTTPS. In Containern stattdessen 0.0.0.0.
# Das Händlerportal belegt auf dem Server bereits 3000, deshalb 3001.
PORT=3001
HOST=127.0.0.1

# Ablage der Videodateien. Im Betrieb außerhalb des Anwendungsverzeichnisses,
# sonst ist bei einem Neu-Deploy alles weg. Die Dateien kommen per SFTP/rsync
# dorthin; die Verwaltung verknüpft sie nur mit den Kacheln. Ausgeliefert wird
# ausschließlich über /api/portal/videos/:id/stream nach Berechtigungsprüfung.
VIDEO_DIR=/var/lib/stneuro/videos

# Ablage der Vorschaubilder (je Video ein JPEG). Bewusst NICHT in VIDEO_DIR,
# sonst tauchten sie dort in der Dateiauswahl auf. Sie lassen sich jederzeit
# in der Verwaltung neu erzeugen und müssen deshalb nicht gesichert werden.
THUMB_DIR=/var/lib/stneuro/vorschaubilder

# ── MariaDB ────────────────────────────────────────────────────────────
# Nutzer, Pakete, Videos und Sitzungen liegen in MariaDB. Ohne erreichbare
# Datenbank startet der Dienst nicht. Das Schema legt er beim Start selbst an.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stneuro
DB_USER=stneuro
DB_PASSWORD=hier-das-datenbank-passwort

# Erster Backend-Zugang. Ist bereits ein Zugang vorhanden, setzt ADMIN_PASSWORD
# beim Start dessen Passwort zurück — so kommt man nach einem vergessenen
# Passwort wieder hinein. Danach die Zeile wieder auskommentieren, sonst wird
# das Passwort bei jedem Neustart erneut darauf festgelegt.
ADMIN_USER=admin
# ADMIN_PASSWORD=hier-ein-langes-passwort

# Selbstregistrierung. Auf 0 setzen, wenn Zugänge nur persönlich vergeben
# werden sollen — das Formular ist dann weg und der Endpunkt geschlossen.
# Neue Konten bekommen nie automatisch Pakete; sie sehen zunächst nur das
# öffentlich Verfügbare.
REGISTRIERUNG=1

# Startguthaben für ein neu registriertes Konto, in Neuro.
#
# Ohne Angabe 0 — dann bekommt ein neues Konto nichts, wie bisher. Für
# zeitlich begrenzte Aktionen ist das hier NICHT der richtige Ort: die legt
# man im Backend unter „Aktionen" an, samt Zeitraum und Obergrenze. Wer sich
# im Fenster registriert, bekommt dann den Aktionsbetrag statt dieses hier.
# START_CREDITS=3

# Adresse für Rückfragen. Steht in der Fußzeile und bei den Bestellungen.
#
# Ohne Angabe schweigt die Oberfläche, statt auf eine erfundene Adresse zu
# zeigen. Dorthin melden sich Kunden auch, wenn sie einen Kauf zurückgeben
# wollen — erstattet wird im Backend, solange von den Neuro nichts ausgegeben
# wurde.
# KONTAKT_EMAIL=hilfe@example.de

# ── Postausgang ────────────────────────────────────────────────────────
#
# Gebraucht für die Bestellbestaetigung. Die ist nicht schmueckendes Beiwerk:
# bei digitalen Inhalten erlischt das Widerrufsrecht nur, wenn der Kaeufer
# eine Bestaetigung auf einem dauerhaften Datentraeger bekommen hat
# (§ 356 Abs. 6 Nr. 2 Buchst. d BGB verweist auf § 312f). Ohne SMTP_HOST
# bleibt der Versand aus, und der Server warnt bei jeder Buchung.
# SMTP_HOST=mail.example.de
# SMTP_PORT=587
# SMTP_USER=portal@example.de
# SMTP_PASSWORT=hier-das-postfach-passwort
# MAIL_ABSENDER=portal@example.de
# MAIL_BETREIBER=stneuro

# ── Zahlwege für Credits ────────────────────────────────────────────────
#
# Vorkasse per Überweisung. Ohne IBAN ist der Zahlweg schlicht aus — eine
# Überweisungsmaske ohne Empfänger wäre schlimmer als gar keine. Der Eingang
# wird im Backend unter „Bestellungen" von Hand bestätigt; erst dann entsteht
# Guthaben. Zugeordnet wird über den Verwendungszweck, den das Portal je
# Bestellung vergibt.
# VORKASSE_EMPFAENGER=Max Mustermann
# VORKASSE_IBAN=DE02120300000000202051
# VORKASSE_BIC=BYLADEM1001
# VORKASSE_BANK=Deutsche Kreditbank
# VORKASSE_DAUER=1-3 Werktage nach Zahlungseingang

# Wie lange eine Bestellung ohne Zahlungseingang stehen bleibt, in Tagen.
#
# Danach geht sie auf "abgelaufen" — sie verschwindet nicht, sie rutscht nur
# aus der Arbeitsliste. Buchen laesst sie sich weiterhin, falls das Geld doch
# noch eintrifft. Ohne Angabe 14.
# BESTELLUNG_VERFALL_TAGE=14

# PayPal. Ohne CLIENT_ID und SECRET ist der Zahlweg aus.
#
# PAYPAL_ENV bleibt ohne Angabe auf "sandbox" — wer die Umgebung vergisst,
# testet, statt versehentlich echtes Geld einzuziehen. Für den Echtbetrieb
# ausdrücklich auf "live" setzen UND die Live-Zugangsdaten eintragen; die
# Sandbox-Daten funktionieren dort nicht.
#
# Die Zugangsdaten stehen im PayPal Developer Dashboard unter "Apps &
# Credentials", getrennt nach Sandbox und Live.
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=

# Auf 1, sobald das Portal über HTTPS läuft — dann wird das Sitzungs-Cookie
# nicht mehr über unverschlüsselte Verbindungen gesendet.
SECURE_COOKIES=1
