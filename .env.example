# Vorlage für die Umgebungsvariablen.
#
# Die Anwendung liest KEINE .env-Datei selbst ein — sie nimmt, was in der
# Umgebung steht. Im Betrieb kommt diese Datei nach /etc/stneuro.env und wird
# von systemd über EnvironmentFile= geladen (deploy/README.md).
# Lokal einfach vor den Befehl schreiben: PORT=3002 npm start

# Port und Schnittstelle. Hinter einem Reverse Proxy MUSS HOST auf 127.0.0.1
# stehen, sonst ist die Anwendung unter Umgehung von Apache direkt erreichbar
# — und damit ohne HTTPS. In Containern stattdessen 0.0.0.0.
# Das Händlerportal belegt auf dem Server bereits 3000, deshalb 3001.
PORT=3001
HOST=127.0.0.1

# Ablage der Videodateien. Im Betrieb außerhalb des Anwendungsverzeichnisses,
# sonst ist bei einem Neu-Deploy alles weg. Die Dateien kommen per SFTP/rsync
# dorthin; die Verwaltung verknüpft sie nur mit den Kacheln. Ausgeliefert wird
# ausschließlich über /api/portal/videos/:id/stream nach Berechtigungsprüfung.
VIDEO_DIR=/var/lib/stneuro/videos

# Ablage der Vorschaubilder (je Video ein JPEG). Bewusst NICHT in VIDEO_DIR,
# sonst tauchten sie dort in der Dateiauswahl auf. Sie lassen sich jederzeit
# in der Verwaltung neu erzeugen und müssen deshalb nicht gesichert werden.
THUMB_DIR=/var/lib/stneuro/vorschaubilder

# ── MariaDB ────────────────────────────────────────────────────────────
# Nutzer, Pakete, Videos und Sitzungen liegen in MariaDB. Ohne erreichbare
# Datenbank startet der Dienst nicht. Das Schema legt er beim Start selbst an.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stneuro
DB_USER=stneuro
DB_PASSWORD=hier-das-datenbank-passwort

# Erster Backend-Zugang. Ist bereits ein Zugang vorhanden, setzt ADMIN_PASSWORD
# beim Start dessen Passwort zurück — so kommt man nach einem vergessenen
# Passwort wieder hinein. Danach die Zeile wieder auskommentieren, sonst wird
# das Passwort bei jedem Neustart erneut darauf festgelegt.
ADMIN_USER=admin
# ADMIN_PASSWORD=hier-ein-langes-passwort

# Selbstregistrierung. Auf 0 setzen, wenn Zugänge nur persönlich vergeben
# werden sollen — das Formular ist dann weg und der Endpunkt geschlossen.
# Neue Konten bekommen nie automatisch Pakete; sie sehen zunächst nur das
# öffentlich Verfügbare.
REGISTRIERUNG=1

# Credit-Kauf OHNE Bezahlung — nur für die Entwicklung.
#
# Auf 1 schreibt /api/portal/credits/kaufen das gewählte Paket sofort gut,
# ohne dass jemand etwas bezahlt hat. Auf einem erreichbaren Server muss die
# Variable UNGESETZT bleiben: sonst holt sich jeder Angemeldete beliebig viel
# Guthaben. Ungesetzt antwortet der Endpunkt mit 501, die Staffel bleibt in
# der Oberfläche als Preisliste sichtbar.
#
# Sobald ein Zahlungsanbieter angebunden ist, ersetzt dessen Bestätigung
# diesen Schalter — gutgeschrieben wird dann über dieselbe Funktion.
# CREDITS_TESTKAUF=1

# Auf 1, sobald das Portal über HTTPS läuft — dann wird das Sitzungs-Cookie
# nicht mehr über unverschlüsselte Verbindungen gesendet.
SECURE_COOKIES=1
