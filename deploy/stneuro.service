# /etc/systemd/system/stneuro.service
#
# Installation:
#   sudo cp deploy/stneuro.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stneuro

[Unit]
Description=stneuro Videoportal
After=network-online.target
Wants=network-online.target
# Nach einem Fehlstart nicht endlos im Sekundentakt neu starten. Die beiden
# gehören nach [Unit] — unter [Service] ignoriert systemd sie mit einer
# Warnung („Unknown key"), und die Bremse greift nicht.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=stneuro
Group=stneuro
# /opt/stneuro ist das Heimatverzeichnis (Deploy Key, npm-Zwischenspeicher),
# die Anwendung liegt eine Ebene tiefer — git clone verlangt ein leeres Ziel.
WorkingDirectory=/opt/stneuro/app

# PORT, HOST, SECURE_COOKIES … — siehe deploy/README.md.
# Die Datei gehört NICHT ins Repo: sie kann ADMIN_PASSWORD enthalten.
EnvironmentFile=/etc/stneuro.env

ExecStart=/usr/bin/node server-dist/server/index.js

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=stneuro

# ── Härtung ──────────────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

# Die Videodateien liegen hier; der Dienst liest sie nur, das Verzeichnis
# anlegen darf er aber (bootstrap). Hochgeladen wird per SFTP/rsync.
ReadWritePaths=/var/lib/stneuro

# Der Dienst lauscht auf localhost, spricht MariaDB — und geht nach außen:
# zu PayPal (api-m.paypal.com) und zum Postausgang. Wer hier später mit
# IPAddressDeny nachschärft, muss beide durchlassen, sonst scheitern
# Zahlungen und Bestellbestätigungen still.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
